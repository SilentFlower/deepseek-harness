# The repo's canonical text form is LF, enforced at checkout too: no smudge
# boundary between working tree and repo, so byte-level gates (verify-*
# comparisons, blob hashing, coverage offsets) see one form on every host.
# Windows command scripts require CRLF in the working tree for cmd.exe; the
# override after the default keeps the in-repo form normalized as text.
* text=auto eol=lf
*.cmd text eol=crlf

*.pdf binary

# The persistence catalog is the readable projection of these generated schemas.
docs/persistence-schema.json linguist-generated=true
docs/persistence-changes/*.schema.json linguist-generated=true
docs/persistence-changes/releases/*.schema.json linguist-generated=true
docs/persistence-changes/historical-formats/*.schema.json linguist-generated=true

# Unified patch blank context lines require their leading space.
patches/*.patch whitespace=-blank-at-eol

# Trellis: append-only developer journals should merge cleanly across
# parallel sessions/worktrees — each session only appends a new block, so
# there is nothing to actually conflict on.
#
# Do NOT add a rule for workspace/*/index.md here — it is fully regenerated
# every session, so a real conflict there is expected and safe to resolve by
# picking either side (task state lives in task.json, not index.md). See
# .trellis/spec/cli/backend/directory-structure.md for details.
.trellis/workspace/*/journal-*.md merge=union

# Flower 快照保留包内原始字节，避免与安装记录中的摘要不一致。
.agents/skills/trellis-channel/references/command-reference.md whitespace=-blank-at-eof
.claude/skills/trellis-channel/references/command-reference.md whitespace=-blank-at-eof
.agents/skills/trellis-meta/references/local-architecture/workspace-memory.md whitespace=-blank-at-eol
.claude/skills/trellis-meta/references/local-architecture/workspace-memory.md whitespace=-blank-at-eol
